GIGACHAT_CREDENTIALS=ваш_ключ_авторизации
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MAX_TOKENS=3000
GIGACHAT_VERIFY_SSL_CERTS=true
TAVILY_API_KEY=ваш_ключ_tavily
# При ошибке доверия укажите PEM-файл доверенного центра сертификации:
# GIGACHAT_CA_BUNDLE=/absolute/path/to/trusted-ca.pem
